# MoveMeOn Project Monitor — copy to .env and fill real values.
# Never commit secrets.

MOVEMEON_EMAIL=your-movemeon-email@example.com
MOVEMEON_PASSWORD=your-movemeon-password
MOVEMEON_DASHBOARD_URL=https://portal.movemeon.com/dashboard/candidate/jobs
MOVEMEON_JOBS_URL=https://portal.movemeon.com/dashboard/candidate/jobs

# Shared Supabase project (same as Catalant and BTG). Prefer SECRET_KEY.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only when SUPABASE_SECRET_KEY is absent:
SUPABASE_SERVICE_ROLE_KEY=

# Optional migration / CLI linking:
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-sender@example.com
SENDER_PASSWORD=your-app-password
RECIPIENT_EMAILS=project1@example.com,project2@example.com

# Operational error alerts (login/SMTP/browser/scan failures)
ERROR_RECIPIENT=ops-alert@example.com
ERROR_EMAIL_COOLDOWN_MINUTES=30

# Suppress project notification emails on the very first scan after process start
SUPPRESS_PROJECT_EMAILS_ON_FIRST_SCAN=false

# Immediate SMTP send retries (fresh connection each attempt)
SMTP_SEND_MAX_ATTEMPTS=3

DAILY_RUN_HOUR=23
DAILY_RUN_MINUTE=0
MAX_AGE_MINUTES=60

HEADLESS=true
SELENIUM_REMOTE_URL=
CHROME_BIN=
CHROMEDRIVER_PATH=
COOKIE_FILE=movemeon_cookies.json

DETAIL_FETCH_DELAY_SECONDS=2
DETAIL_FETCH_MAX_ATTEMPTS=2
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_MINUTES=15
DETAIL_MAX_AUTOMATIC_ATTEMPTS=3
DETAIL_RETRY_COOLDOWN_MINUTES=360
DETAIL_AUTO_ENRICHMENT_ENABLED=true

WORKER_LOCK_ENABLED=true
WORKER_LOCK_TTL_SECONDS=180

# Same-day Chrome crash recovery (retry this scan; do not wait 24h)
SCAN_CRASH_MAX_RETRIES=3
SCAN_CRASH_RETRY_SECONDS=45

TZ=Asia/Karachi
